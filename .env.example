# ── Groship Saathi — environment ──
# Copy this file to `.env` and set the API base URL.

# The g-backend API (feature/field-agent-saathi), mounted at /api/v1.
#
# A phone/emulator cannot reach the host's `localhost`. Use ONE of:
#   • Android emulator (AVD):   http://10.0.2.2:3000/api/v1
#   • Physical device on LAN:   http://192.168.x.x:3000/api/v1   (your machine's LAN IP)
#   • Tunnel (ngrok / cloudflared): https://<subdomain>/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
